    (uuid 2c85a325-50de-4a94-842d-ff49efd4b12d)
  )
  (text "Notes:\nBuck Converter providing the 12V power rail\nInput Voltage: 9-53V\nMax Input current: 10A\nEfficiency: 89-96.5%\nRipple & Noise: 0.02 Vpp\nSwitching Frequency: 450 kHz\n(TRIM resistor Rup should be connected as close to the i3A module \nas possible)"
    (at 13.97 237.49 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 2d9cac73-25d5-47fa-844d-f4b265ba5914)
  )
