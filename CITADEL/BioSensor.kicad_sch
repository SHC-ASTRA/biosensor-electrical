  (text "Test Strip Rotating motor/ Lynx motor\n\ngoes to the 4 pin connector. \ntestStrip rIn \n	controls angular position\ntestStrip rOut\n	rotational position feedback\nBoth use 3.3V PWM"
    (at 535.94 110.49 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 6b84db21-7165-4531-8f9a-ccfee9e02b70)
